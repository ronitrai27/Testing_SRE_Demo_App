# Copy to .env. Every value is optional; the defaults run the app locally.
# HOST=127.0.0.1
# PORT=4100
# LOG_LEVEL=info
# DATABASE_PATH=data/shop.db
# SESSION_TTL_HOURS=24
# COOKIE_SECURE=false
# PAYMENT_GATEWAY_URL=http://127.0.0.1:4200
# PAYMENT_TIMEOUT_MS=3000

# Leave empty to run without Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
