{
  "name": "@saltmarket/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "start": "node --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "node --env-file-if-exists=.env src/cli/reset.ts"
  },
  "dependencies": {
    "@saltmarket/contracts": "0.1.0",
    "@sentry/node": "11.17.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6"
  }
}
